# ==============================================================================
# Cognify — Environment Configuration Example
# Copy this file to .env and configure the values for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI PROVIDERS (Required for Live Multi-Agent Evaluation & AI Tutoring)
# ------------------------------------------------------------------------------
# Google Gemini API key (recommended: gemini-3.8-flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional: OpenAI fallback API key (gpt-4o-mini)
# OPENAI_API_KEY=your_openai_api_key_here

# Note: If no AI key is configured, Cognify operates in deterministic rubric fallback mode.

# ------------------------------------------------------------------------------
# 2. SUPABASE (Optional: Required for Cloud Authentication & Cross-Device Sync)
# ------------------------------------------------------------------------------
# If unconfigured, Cognify runs in Guest Mode with full offline localStorage persistence.

# Option A: Full Supabase Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Option B: Alternatively, specify only the Project ID (the URL is derived automatically)
# VITE_SUPABASE_PROJECT_ID=your-project-ref

# Supabase Public / Anon API Key (both variable names are supported on client):
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# ------------------------------------------------------------------------------
# 3. SERVER / CLOUDFLARE RUNTIME (SSR & Server Function Middleware)
# ------------------------------------------------------------------------------
# In Cloudflare Pages / Workers, set these in Dashboard -> Settings -> Variables and Secrets:
SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key
# SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# SECURITY: Service role key is STRICTLY SERVER-SIDE for admin database tasks.
# NEVER expose this key with a VITE_ prefix or to client-side bundles.
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 4. DATABASE & CRON (Optional)
# ------------------------------------------------------------------------------
# PostgreSQL direct connection string for Drizzle ORM schema migrations:
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Cron authentication secret for authenticated scheduled task triggers:
# CRON_SECRET=your_secure_cron_secret
